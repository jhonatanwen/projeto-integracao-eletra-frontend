<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="480.0" prefWidth="854.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eletra.controller.MainController">
   <children>
      <VBox AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <children>
            <Label text="Autor: Jhonatan">
               <padding>
                  <Insets left="3.0" top="3.0" />
               </padding>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
            <Separator prefHeight="18.0">
               <VBox.margin>
                  <Insets left="3.0" right="3.0" />
               </VBox.margin>
            </Separator>
            <Accordion cache="true" cacheHint="SCALE_AND_ROTATE">
              <panes>
                  <TitledPane fx:id="tpLines" animated="false" expanded="false" text="Linhas">
                     <content>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label text="Selecione uma Linha:">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Label>
                              <ComboBox fx:id="cbLines">
                                 <HBox.margin>
                                    <Insets />
                                 </HBox.margin>
                              </ComboBox>
                           </children>
                        </HBox>
                     </content>
                     <font>
                        <Font size="17.0" />
                     </font>
                  </TitledPane>
                  <TitledPane fx:id="tpModels" animated="false" disable="true" expanded="false" text="Modelos">
                     <content>
                        <HBox spacing="15.0">
                           <children>
                              <Label text="Lista de Modelos:">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Label>
                              <TreeView fx:id="tvModels" />
                           </children>
                        </HBox>
                     </content>
                     <font>
                        <Font size="17.0" />
                     </font>
                  </TitledPane>
              </panes>
            </Accordion>
         </children>
      </VBox>
   </children>
</AnchorPane>
